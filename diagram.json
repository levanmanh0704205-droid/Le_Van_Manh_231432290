{
  "version": 1,
  "author": "ESP32 Fire Alarm MQTT Demo",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-gas-sensor",
      "id": "mq2",
      "top": -120,
      "left": -250,
      "attrs": { "ppm": "400" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -95.7,
      "left": 253.8,
      "attrs": { "temperature": "29", "humidity": "50" }
    },
    {
      "type": "wokwi-led",
      "id": "fan",
      "top": 140,
      "left": -200,
      "attrs": { "color": "blue", "label": "Fan" }
    },
    {
      "type": "wokwi-led",
      "id": "pump",
      "top": 140,
      "left": 250,
      "attrs": { "color": "red", "label": "Pump" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rfan",
      "top": 180,
      "left": -200,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rpump",
      "top": 180,
      "left": 250,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "mq2:VCC", "esp:5V", "red", [] ],
    [ "mq2:GND", "esp:GND.1", "black", [] ],
    [ "mq2:AOUT", "esp:34", "green", [] ],
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.2", "black", [] ],
    [ "dht:SDA", "esp:4", "green", [] ],
    [ "esp:18", "fan:A", "blue", [] ],
    [ "fan:C", "rfan:1", "black", [] ],
    [ "rfan:2", "esp:GND.1", "black", [] ],
    [ "esp:19", "pump:A", "orange", [] ],
    [ "pump:C", "rpump:1", "black", [] ],
    [ "rpump:2", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}